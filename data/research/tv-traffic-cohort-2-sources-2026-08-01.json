  "known_conflicts": [
    {
      "id": "wireless-protocols-are-not-interchangeable",
      "canonicals": [
        "laptop-to-tv"
      ],
      "resolution": "Windows Miracast and Mac AirPlay are separate paths. Require matching support at both endpoints and never infer either from Smart TV branding."
    },
    {
      "id": "usb-c-connector-is-not-a-video-capability",
      "canonicals": [
        "laptop-to-tv"
      ],
      "resolution": "Require device documentation or an explicit DisplayPort Alt Mode or Thunderbolt capability. Connector shape alone is insufficient, and adapter direction must match a video source to a display input."
    },
    {
      "id": "physical-coax-does-not-name-the-service",
      "canonicals": [
        "digital-channels"
      ],
      "resolution": "Ask whether the feed is terrestrial antenna, cable provider or an external box before selecting Antenna or Cable in the television menu."
    },
    {
      "id": "vendor-picture-modes-are-not-calibration",
      "canonicals": [
        "picture-setup"
      ],
      "resolution": "Treat presets and sliders as model/input/user-goal controls. Never publish universal numeric values or claim measured calibration without instruments."
    },
    {
      "id": "game-mode-is-model-input-and-content-scoped",
      "canonicals": [
        "picture-setup"
      ],
      "resolution": "Describe Game Mode only for a confirmed model, input and gaming use. Do not promise a numeric latency reduction, force it through hidden menus or recommend it for ordinary television viewing."
    },
    {
      "id": "hdr-lock-is-not-a-defect-by-itself",
      "canonicals": [
        "picture-setup"
      ],
      "resolution": "A locked Picture Mode can be documented HDR behavior on an applicable Sony model. Verify model, input and HDR content before exposing only the controls the official source says remain available."
    },
    {
      "id": "browser-pattern-vs-built-in-test",
      "canonicals": [
        "picture-setup"
      ],
      "resolution": "Browser patterns can reveal an observation but cannot replace a television built-in self-test or diagnose a panel fault."
    }
  ],
