    {
      "id": "tv-remote-vs-set-top-box-remote",
      "canonicals": [
        "remote-not-working"
      ],
      "resolution": "Ask which device the user is trying to control. A provider set-top box can require its own remote, so failure to change channels with the television remote is not evidence that either device is broken."
    },
    {
      "id": "phone-remote-is-conditional",
      "canonicals": [
        "remote-not-working"
      ],
      "resolution": "Offer the Google TV phone remote only for confirmed Android TV compatibility, an Android phone, same-network access and a pairing path the user can complete. Otherwise keep it unavailable."
    }
