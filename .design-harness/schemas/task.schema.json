{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.design-harness/schema/task-v1.json",
  "title": "Programmatic Design Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "status",
    "implementer",
    "created_at",
    "states",
    "viewports",
    "allowed_files",
    "verification_commands",
    "asset_specs",
    "exact_content",
    "claims",
    "sources"
  ],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9]{8}-[a-z0-9-]+$"},
    "kind": {"enum": ["ui", "infographic", "social", "brand", "mixed"]},
    "status": {"enum": ["draft", "ready", "shipped"]},
    "implementer": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "states": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "width", "height"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "theme": {"type": "string"},
          "locale": {"type": "string"}
        }
      }
    },
    "allowed_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "required": {"type": "boolean", "default": true},
          "covers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "asset_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "width", "height", "format", "content_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "format": {"enum": ["png", "jpg", "jpeg", "webp", "gif", "svg"]},
          "content_type": {"enum": ["decorative", "informative", "complex"]},
          "safe_zone": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "top": {"type": "integer", "minimum": 0},
              "right": {"type": "integer", "minimum": 0},
              "bottom": {"type": "integer", "minimum": 0},
              "left": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "exact_content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "strategy"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "strategy": {"const": "deterministic-overlay"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "retrieved_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "path": {"type": "string"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "notes": {"type": "string"}
        },
        "anyOf": [{"required": ["url"]}, {"required": ["path"]}]
      }
    }
  }
}
