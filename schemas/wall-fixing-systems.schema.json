{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krepitv.ru/schemas/wall-fixing-systems.schema.json",
  "title": "KREPI TV wall fixing systems",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "systems", "exact_recommendations"],
  "properties": {
    "schema_version": { "const": 1 },
    "systems": {
      "type": "array",
      "items": { "$ref": "#/$defs/system" }
    },
    "exact_recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/exactRecommendation" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "source_title",
        "source_publisher",
        "source_region",
        "checked_at"
      ],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_title": { "type": "string", "minLength": 3 },
        "source_publisher": { "type": "string", "minLength": 2 },
        "source_region": { "type": "string", "minLength": 2 },
        "checked_at": { "type": "string", "format": "date" }
      }
    },
    "wallProfile": {
      "enum": [
        "concrete",
        "solid-brick",
        "hollow-block",
        "aerated-block",
        "drywall-with-blocking",
        "drywall-without-blocking"
      ]
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manufacturer",
        "product_title",
        "allowed_wall_profiles",
        "scope",
        "limitations",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "manufacturer": { "type": "string", "minLength": 2 },
        "product_title": { "type": "string", "minLength": 3 },
        "allowed_wall_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/wallProfile" }
        },
        "scope": { "const": "class-only" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "exactRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "system_id",
        "mount_id",
        "wall_profile",
        "minimum_base_thickness_mm",
        "fastener_title",
        "quantity",
        "anchor_diameter_mm",
        "anchor_length_mm",
        "drill_diameter_mm",
        "supported_load_kg",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "system_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "mount_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "wall_profile": { "$ref": "#/$defs/wallProfile" },
        "minimum_base_thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
        "fastener_title": { "type": "string", "minLength": 3 },
        "quantity": { "type": "integer", "minimum": 2, "maximum": 16 },
        "anchor_diameter_mm": { "type": "number", "exclusiveMinimum": 0 },
        "anchor_length_mm": { "type": "number", "exclusiveMinimum": 0 },
        "drill_diameter_mm": { "type": "number", "exclusiveMinimum": 0 },
        "supported_load_kg": { "type": "number", "exclusiveMinimum": 0 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
