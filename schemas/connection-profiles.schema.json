{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krepitv.ru/schemas/connection-profiles.schema.json",
  "title": "KREPI TV connection profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "source_title",
        "source_publisher",
        "source_region",
        "checked_at"
      ],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_title": { "type": "string", "minLength": 3 },
        "source_publisher": { "type": "string", "minLength": 2 },
        "source_region": { "type": "string", "minLength": 2 },
        "checked_at": { "type": "string", "format": "date" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "connection_kind",
        "title",
        "allowed_routing",
        "requirements",
        "warnings",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "connection_kind": { "enum": ["power", "hdmi", "ethernet", "antenna", "optical", "usb"] },
        "title": { "type": "string", "minLength": 3 },
        "allowed_routing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["open", "hidden"] }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
