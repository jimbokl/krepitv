{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krepitv:schema:affiliate-orders-monthly-aggregate:v2",
  "title": "KREPI TV privacy-safe monthly affiliate orders aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "month",
    "generated_at",
    "data_as_of",
    "api_window",
    "approved",
    "pending_current",
    "cancelled_in_month",
    "quarantined_current",
    "attribution_winners"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "krepitv_affiliate_orders_monthly_aggregate" },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_as_of": { "type": "string", "format": "date-time" },
    "api_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_start",
        "update_end",
        "pages",
        "records",
        "known_records",
        "quarantined_records"
      ],
      "properties": {
        "update_start": { "type": "string", "format": "date-time" },
        "update_end": { "type": "string", "format": "date-time" },
        "pages": { "$ref": "#/$defs/count" },
        "records": { "$ref": "#/$defs/count" },
        "known_records": { "$ref": "#/$defs/count" },
        "quarantined_records": { "$ref": "#/$defs/count" }
      }
    },
    "approved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orders", "payment_kopecks"],
      "properties": {
        "orders": { "$ref": "#/$defs/count" },
        "payment_kopecks": { "$ref": "#/$defs/count" }
      }
    },
    "pending_current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_orders",
        "on_hold_orders",
        "payment_kopecks",
        "note"
      ],
      "properties": {
        "new_orders": { "$ref": "#/$defs/count" },
        "on_hold_orders": { "$ref": "#/$defs/count" },
        "payment_kopecks": { "$ref": "#/$defs/count" },
        "note": { "const": "Не является подтверждённой выручкой" }
      }
    },
    "cancelled_in_month": { "$ref": "#/$defs/orderCount" },
    "quarantined_current": { "$ref": "#/$defs/orderCount" },
    "attribution_winners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "rows", "unattributed"],
      "properties": {
        "dimensions": {
          "type": "array",
          "prefixItems": [
            { "const": "surface" },
            { "const": "landing_path" },
            { "const": "entity_id" },
            { "const": "rank" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributionRow" }
        },
        "unattributed": { "$ref": "#/$defs/attributionCounters" }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "orderCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orders"],
      "properties": {
        "orders": { "$ref": "#/$defs/count" }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["APPROVED", "NEW", "ON_HOLD", "CANCELLED"],
      "properties": {
        "APPROVED": { "$ref": "#/$defs/count" },
        "NEW": { "$ref": "#/$defs/count" },
        "ON_HOLD": { "$ref": "#/$defs/count" },
        "CANCELLED": { "$ref": "#/$defs/count" }
      }
    },
    "attributionCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orders", "approved_payment_kopecks"],
      "properties": {
        "orders": { "$ref": "#/$defs/statusCounts" },
        "approved_payment_kopecks": { "$ref": "#/$defs/count" }
      }
    },
    "attributionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "landing_path",
        "entity_id",
        "rank",
        "orders",
        "approved_payment_kopecks"
      ],
      "properties": {
        "surface": {
          "enum": ["mount_page", "product_page", "seo_hub", "model_page"]
        },
        "landing_path": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9/-]*/$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "rank": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "orders": { "$ref": "#/$defs/statusCounts" },
        "approved_payment_kopecks": { "$ref": "#/$defs/count" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "surface": { "enum": ["seo_hub", "model_page"] }
            },
            "required": ["surface"]
          },
          "then": {
            "properties": {
              "rank": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          },
          "else": {
            "properties": { "rank": { "type": "null" } }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "orders": {
                  "properties": { "APPROVED": { "minimum": 1 } }
                }
              }
            },
            {
              "properties": {
                "orders": {
                  "properties": { "NEW": { "minimum": 1 } }
                }
              }
            },
            {
              "properties": {
                "orders": {
                  "properties": { "ON_HOLD": { "minimum": 1 } }
                }
              }
            },
            {
              "properties": {
                "orders": {
                  "properties": { "CANCELLED": { "minimum": 1 } }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
