{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krepitv.ru/schemas/model-ports.schema.json",
  "title": "KREPI TV model port passports",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/modelPorts" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "source_title",
        "source_publisher",
        "source_region",
        "checked_at"
      ],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_title": { "type": "string", "minLength": 3 },
        "source_publisher": { "type": "string", "minLength": 2 },
        "source_region": { "type": "string", "minLength": 2 },
        "checked_at": { "type": "string", "format": "date" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position", "direction"],
      "properties": {
        "kind": { "enum": ["power", "hdmi", "ethernet", "antenna", "optical", "usb"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "position": { "enum": ["left", "right", "bottom", "rear", "external-box"] },
        "direction": { "enum": ["sideways", "downward", "rearward", "detachable"] }
      }
    },
    "modelPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "ports", "evidence"],
      "properties": {
        "model_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/port" }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
