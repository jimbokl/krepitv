{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/krepitv/market-affiliate-source.schema.json",
  "title": "KREPI TV market affiliate source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cards"],
  "properties": {
    "schema_version": { "const": 2 },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "market_source_url",
        "page_path",
        "entity_kind",
        "entity_id",
        "compliance_mode",
        "clid",
        "vid",
        "expected_title_tokens",
        "creative"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "market_source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "page_path": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9/-]*/$"
        },
        "entity_kind": { "const": "mount" },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "compliance_mode": {
          "enum": ["advertising", "non_ad_storefront"]
        },
        "clid": {
          "type": "string",
          "pattern": "^[0-9]{5,20}$"
        },
        "vid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,150}$"
        },
        "expected_title_tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "creative": {
          "anyOf": [
            { "$ref": "#/$defs/creative" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "compliance_mode": { "const": "advertising" } }
          },
          "then": {
            "properties": { "creative": { "$ref": "#/$defs/creative" } }
          }
        },
        {
          "if": {
            "properties": { "compliance_mode": { "const": "non_ad_storefront" } }
          },
          "then": {
            "properties": { "creative": { "type": "null" } }
          }
        }
      ]
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "content_revision",
        "erid",
        "registered_at",
        "disclosure"
      ],
      "properties": {
        "form": {
          "enum": [
            "banner",
            "text-block",
            "text-graphic-block",
            "video",
            "audio-rec",
            "live-video",
            "live-audio"
          ]
        },
        "content_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,80}$"
        },
        "erid": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._:-]{6,256}$"
        },
        "registered_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "advertiser_name", "advertiser_inn"],
          "properties": {
            "label": { "const": "Реклама" },
            "advertiser_name": { "const": "ООО «Яндекс Маркет»" },
            "advertiser_inn": { "const": "9704254424" }
          }
        }
      }
    }
  }
}
