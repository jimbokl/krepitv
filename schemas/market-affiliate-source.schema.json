{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/krepitv/market-affiliate-source.schema.json",
  "title": "KREPI TV market affiliate source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cards"],
  "properties": {
    "schema_version": { "const": 1 },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "market_source_url",
        "page_path",
        "vid",
        "creative"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "market_source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "page_path": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9/-]*/$"
        },
        "vid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,150}$"
        },
        "creative": { "$ref": "#/$defs/creative" }
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "content_revision",
        "erid",
        "registered_at",
        "disclosure"
      ],
      "properties": {
        "form": {
          "enum": [
            "banner",
            "text-block",
            "text-graphic-block",
            "video",
            "audio-rec",
            "live-video",
            "live-audio"
          ]
        },
        "content_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,80}$"
        },
        "erid": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._:-]{6,256}$"
        },
        "registered_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "advertiser_name", "advertiser_inn"],
          "properties": {
            "label": { "const": "Реклама" },
            "advertiser_name": { "const": "ООО «Яндекс Маркет»" },
            "advertiser_inn": { "const": "9704254424" }
          }
        }
      }
    }
  }
}
