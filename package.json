{
  "name": "krepitv",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:content": "cargo run -p krepitv-sitegen --release",
    "build:wasm": "wasm-pack build crates/engine --target web --out-dir ../../web/public/pkg --release",
    "build:web": "npm --prefix web run build",
    "build:publish": "node scripts/copy-dist.mjs",
    "build": "node scripts/clean.mjs && npm run build:content && npm run build:wasm && npm run build:web && npm run build:publish && npm run verify",
    "catalog:verify": "node scripts/catalog/verify-coverage.mjs",
    "catalog:sync": "node scripts/catalog/sync-model-catalog.mjs && node scripts/catalog/sync-mount-catalog.mjs",
    "catalog:test": "node --test tests/catalog/*.test.mjs",
    "research:tv-demand": "node scripts/research/collect-tv-model-demand.mjs",
    "research:seo-hubs": "node scripts/research/collect-seo-hub-demand.mjs",
    "research:merge-tv-demand": "node scripts/research/merge-tv-model-demand.mjs",
    "qa:screenshot": "node scripts/qa/capture-page.mjs",
    "affiliate:validate": "node scripts/affiliate/validate.mjs --kind source data/affiliate/market-products.json",
    "affiliate:validate-public": "node scripts/affiliate/validate.mjs --kind public data/affiliate/public-offers.json",
    "affiliate:check-market": "node scripts/affiliate/check-market-links.mjs",
    "affiliate:check-market-chrome": "node scripts/affiliate/check-market-links-chrome.mjs",
    "affiliate:build-snapshot": "node scripts/affiliate/build-snapshot.mjs --source data/affiliate/market-products.json --batch .private/market-affiliate-batch.json --out .private/market-affiliate-snapshot.json",
    "affiliate:publish-snapshot": "node scripts/affiliate/publish-snapshot.mjs",
    "affiliate:validate-hubs": "node scripts/affiliate/validate-hub-placements.mjs --kind manifest data/affiliate/seo-hub-placements.json",
    "affiliate:check-hubs": "node scripts/affiliate/check-hub-placements.mjs",
    "affiliate:build-hub-snapshot": "node scripts/affiliate/build-hub-snapshot.mjs",
    "affiliate:publish-hub-snapshot": "node scripts/affiliate/publish-hub-snapshot.mjs",
    "affiliate:validate-hubs-public": "node scripts/affiliate/validate-hub-placements.mjs --kind public data/affiliate/public-hub-offers.json",
    "affiliate:generate-models": "node scripts/affiliate/generate-model-placements.mjs --out",
    "affiliate:check-model-manifest": "node scripts/affiliate/generate-model-placements.mjs --check",
    "affiliate:validate-models": "node scripts/affiliate/validate-model-placements.mjs --kind manifest data/affiliate/model-page-placements.json",
    "affiliate:check-models": "node scripts/affiliate/check-model-placements.mjs",
    "affiliate:build-model-snapshot": "node scripts/affiliate/build-model-snapshot.mjs",
    "affiliate:publish-model-snapshot": "node scripts/affiliate/publish-model-snapshot.mjs",
    "affiliate:validate-models-public": "node scripts/affiliate/validate-model-placements.mjs --kind public data/affiliate/public-model-offers.json",
    "affiliate:orders-sync": "node scripts/affiliate/sync-orders.mjs --clid 15238076",
    "affiliate:orders-report": "node scripts/affiliate/report-orders.mjs",
    "affiliate:test": "node --test tests/affiliate/*.test.mjs",
    "indexnow:submit": "node scripts/indexnow/submit.mjs",
    "indexnow:test": "node --test tests/indexnow/*.test.mjs",
    "analytics:goals:check": "node scripts/analytics/manage-metrika-goals.mjs",
    "analytics:goals:apply": "node scripts/analytics/manage-metrika-goals.mjs --apply",
    "analytics:test": "node --test tests/analytics/*.test.mjs",
    "dev:prepare": "npm run build:content && npm run build:wasm",
    "dev": "npm run dev:prepare && npm --prefix web run dev",
    "verify": "cargo test --workspace && npm --prefix web run check:ru && npm --prefix web run test:sites && npm run catalog:verify && npm run catalog:test && node scripts/verify.mjs && npm run affiliate:validate && npm run affiliate:validate-public && npm run affiliate:validate-hubs && npm run affiliate:validate-hubs-public && npm run affiliate:check-model-manifest && npm run affiliate:validate-models && npm run affiliate:validate-models-public && npm run affiliate:test && npm run indexnow:test && npm run analytics:test"
  }
}
